{
  "manifest_version": 3,
  "name": "拖拽快捷键",
  "version": "1.0.0",
  "description": "在网页上拾取起点和终点，按字母键自动模拟拖拽或点击。",
  "permissions": ["storage", "debugger", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "拖拽快捷键"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
